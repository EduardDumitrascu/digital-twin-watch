# Copy to .env on the server only. Never commit real values. Never paste secrets into chat.
# Meta Model API key (backend only). Without it the app runs with AI = "Not configured".
MODEL_API_KEY=
# Digitransit subscription key (backend only). Register at the Digitransit API
# portal and subscribe to the Routing product. Sent upstream only as the
# digitransit-subscription-key header; never exposed to the frontend.
# Without it the app runs with routing/tiles = "Not configured" (no fake routes).
DIGITRANSIT_API_KEY=
# Reviewer token for review/action/closure endpoints (backend only, long random value).
REVIEWER_TOKEN=
# Optional: Meta model id (default: muse-spark-1.2) and API base override.
META_MODEL=muse-spark-1.2
META_API_URL=https://api.meta.ai/v1/chat/completions
# Optional: Digitransit endpoint overrides (defaults are the HSL production APIs).
DIGITRANSIT_API_URL=https://api.digitransit.fi/routing/v2/hsl/gtfs/v1
DIGITRANSIT_GEO_URL=https://api.digitransit.fi/geocoding/v1
DIGITRANSIT_MAP_URL=https://cdn.digitransit.fi/map/v3
# Optional: Mapillary client access token (backend only; create one at
# mapillary.com/dashboard/developers). Without it, journey previews run
# without street-level imagery and say so; no imagery is simulated.
MAPILLARY_ACCESS_TOKEN=
PORT=4173
