# Copy to .env on the server only. Never commit real values. Never paste secrets into chat.
# Meta Model API key (backend only). Without it the app runs with AI = "Not configured".
MODEL_API_KEY=
# Optional: Meta model id (default: muse-spark-1.2) and API base override.
META_MODEL=muse-spark-1.2
META_API_URL=https://api.meta.ai/v1/chat/completions
PORT=4173
